+ *   4) di Stok tanpa lapisan -> "Tekan Back sekali lagi untuk keluar" (2 dtk), lalu keluar.
+ * Sentinel dipasang pada interaksi pertama: Chrome melewati entri riwayat yang dibuat tanpa interaksi pengguna. */
+(function(){
+  var HOME='master',SUBS=['alert','cetak','rak','aset'];
+  var LAYERS='.modal-overlay.show,#item-detail-sheet.show,#edit-sheet.show,#add-sheet.show,#rak-label-sheet.show,#pindah-sheet.show';
+  var armed=false,exitUntil=0,toastEl=null,toastT=0;
+  function base(){return location.pathname+location.search;}
+  function curTab(){var s=document.querySelector('.page-section.active');return s&&s.id?s.id.replace('section-',''):HOME;}
+  function pushApp(){try{history.pushState({rdiApp:1},'',base()+'#'+curTab());}catch(e){}}
+  function arm(){if(armed)return;armed=true;try{history.replaceState({rdiBase:1},'',base()+'#__base');pushApp();}catch(e){armed=false;}}
+  ['pointerdown','touchstart','keydown'].forEach(function(t){document.addEventListener(t,arm,{once:true,passive:true,capture:true});});
+  function toast(msg,ms){if(!toastEl){toastEl=document.createElement('div');toastEl.id='back-exit-toast';toastEl.setAttribute('role','status');toastEl.setAttribute('aria-live','polite');toastEl.style.cssText='position:fixed;left:50%;transform:translateX(-50%);bottom:calc(88px + env(safe-area-inset-bottom,0px));z-index:2000;background:rgba(15,23,42,.92);color:#fff;padding:10px 16px;border-radius:999px;font-size:13px;font-weight:600;max-width:90vw;text-align:center;pointer-events:none';document.body.appendChild(toastEl);}toastEl.textContent=msg;toastEl.style.display='block';clearTimeout(toastT);toastT=setTimeout(function(){toastEl.style.display='none';},ms||2000);}window.rdiToast=toast;
+  window.addEventListener('popstate',function(e){
+    if(!armed)return;
+    if(!(e.state&&e.state.rdiBase))return;
+    if(document.querySelectorAll(LAYERS).length){pushApp();document.dispatchEvent(new KeyboardEvent('keydown',{key:'Escape',bubbles:true}));return;}
+    var t=curTab();
+    if(SUBS.indexOf(t)>=0&&typeof backFromSubpage==='function'){pushApp();backFromSubpage();return;}
+    if(t!==HOME&&typeof switchTab==='function'){pushApp();switchTab(HOME);return;}
+    if(Date.now()<exitUntil){armed=false;history.back();return;}
+    exitUntil=Date.now()+2000;pushApp();toast('Tekan Back sekali lagi untuk keluar');
+  });
+})();
+</script>
 </body>
 </html>
